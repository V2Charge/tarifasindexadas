    "id": "a1b2c3d4e5f60002",
    "type": "function",
    "name": "URL de mañana",
    "func": "const d = new Date(Date.now() + 86400000);\nconst f = d.toLocaleDateString('sv-SE', { timeZone: 'Europe/Madrid' });\nmsg.url = `https://tarifaelectrica.v2charge.com/node-red/indexada/${f}/`;\nreturn msg;",
    "outputs": 1,
    "x": 350,
