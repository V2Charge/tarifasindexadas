    "proxy": "",
    "authType": "",
    "x": 560,
    "y": 80,
    "wires": [["a1b2c3d4e5f60004"]]
  },
  {
    "id": "a1b2c3d4e5f60004",
    "type": "function",
    "name": "Hora más barata",
    "func": "const horas = msg.payload.data;\nconst min = horas.reduce((a, b) => (b.costeConsumo < a.costeConsumo ? b : a));\nmsg.payload = { fecha: min.fecha, hora: min.hora, costeConsumo: min.costeConsumo, horas };\nreturn msg;",
    "outputs": 1,
    "x": 770,
    "y": 80,
    "wires": [["a1b2c3d4e5f60005"]]
  },
